# Example environment configuration for Broker Integration Layer

# API endpoint for fetching all trades (Zerodha or other broker)
GET_ALL_TRADE_URL=https://api.kite.trade/trades

# Broker API key (replace with actual key when running locally)
ZERODHA_API_KEY=<zerodha_api_key>

# Access token for authentication
ACCESS_TOKEN=<access_token>

# Enable mock mode (true = simulate API responses)
MOCK_MODE=true
